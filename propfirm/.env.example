APP_ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/proptrading
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=supersecretkey_change_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

MARKET_DATA_PROVIDER=simulation
SIMULATION_TICK_INTERVAL_MS=100

# Upstox live market data. Keep SIMULATOR for local testing.
MARKET_DATA_SOURCE=SIMULATOR
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8001/api/v1/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=
# Comma-separated SYMBOL=Upstox instrument keys for current-expiry contracts.
# Example: NIFTY-FUT=NSE_FO|NSE_FO_INSTRUMENT_KEY,BANKNIFTY-FUT=NSE_FO|...
UPSTOX_INSTRUMENT_KEYS=

LOG_LEVEL=INFO
